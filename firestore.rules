rules_version = '2';

// ════════════════════════════════════════════════════════════════════
// FutMatch — Reglas de seguridad de Firestore
// Cada regla deja hacer SOLO lo que la app necesita, y nada más.
// (El servidor de notificaciones usa una cuenta de servicio y no pasa
//  por estas reglas.)
// ════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Ayudas ───────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Solo cambian estos campos (y ninguno más)
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function clubData(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data;
    }

    function isCaptain(clubId) {
      return isSignedIn() && exists(/databases/$(database)/documents/clubs/$(clubId)) &&
        clubData(clubId).captainId == request.auth.uid;
    }

    function isCaptainOrVice(clubId) {
      return isSignedIn() && exists(/databases/$(database)/documents/clubs/$(clubId)) &&
        (clubData(clubId).captainId == request.auth.uid ||
         clubData(clubId).get('viceCaptainId', null) == request.auth.uid);
    }

    function isMember(clubId, userId) {
      return exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(userId));
    }

    // ── Perfiles de usuario ──────────────────────────────
    match /users/{userId} {
      allow read: if true; // swipe, comunidad, perfiles públicos
      allow create: if isOwner(userId);
      allow delete: if isOwner(userId); // "Eliminar mi cuenta"

      allow update: if isOwner(userId)
        // Calificar al rival después de un partido: solo los campos de reputación
        || (isSignedIn() && onlyChanges(['rating', 'ratingCount', 'reputationTags', 'negativeReputationTags']))
        // El capitán/vice suma a un jugador a su club (agrega UN club al final de la lista)
        || (isSignedIn() && onlyChanges(['clubIds']) && addsOneClubAsCaptain())
        // Escritura que no cambia nada (ej: sumar un club que ya estaba)
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().size() == 0);
    }

    function addsOneClubAsCaptain() {
      let before = resource.data.get('clubIds', []);
      let after = request.resource.data.get('clubIds', []);
      return after.size() == before.size() + 1 &&
        (before.size() == 0 || after[0:before.size()] == before) &&
        isCaptainOrVice(after[after.size() - 1]);
    }

    // ── Chats ─────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participants
        // Chat de club: un miembro se suma a sí mismo, o el capitán/vice suma a alguien
        || (chatId.matches('group_.+') && onlyChanges(['participants']) &&
            joinsGroupChat(chatId.split('_')[1]))
      );

      match /messages/{messageId} {
        function isParticipant() {
          return isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        allow read: if isParticipant();
        allow create: if isParticipant() && request.resource.data.senderId == request.auth.uid;
        // Los textos no se editan. Solo se puede: aceptar un desafío, votar
        // una encuesta o sumarse a una vaquita (y no cambiar el remitente).
        allow update: if isParticipant() &&
          onlyChanges(['challengeData', 'pollData', 'paymentData']) &&
          request.resource.data.senderId == resource.data.senderId;
        allow delete: if false;
      }
    }

    function joinsGroupChat(clubId) {
      let added = request.resource.data.participants.toSet()
        .difference(resource.data.get('participants', []).toSet());
      return added.size() == 1 && (
        (added.hasOnly([request.auth.uid]) && isMember(clubId, request.auth.uid)) ||
        isCaptainOrVice(clubId)
      );
    }

    // ── Partidos ──────────────────────────────────────────
    // homeId / awayId pueden ser un usuario o un club
    function isMatchSide(sideId) {
      return request.auth.uid == sideId || isMember(sideId, request.auth.uid);
    }

    match /matches/{matchId} {
      allow read: if true; // calendario, etc.
      allow create: if isSignedIn() &&
        (isMatchSide(request.resource.data.homeId) || isMatchSide(request.resource.data.awayId));
      // Solo los que juegan el partido lo pueden modificar (y no cambiar quién juega)
      allow update: if isSignedIn() &&
        (isMatchSide(resource.data.homeId) || isMatchSide(resource.data.awayId)) &&
        request.resource.data.homeId == resource.data.homeId &&
        request.resource.data.awayId == resource.data.awayId;
      allow delete: if false;
    }

    // ── Clubes ────────────────────────────────────────────
    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.captainId == request.auth.uid;
      allow delete: if false;

      allow update: if isSignedIn() && (
        // Capitán: puede todo (incluido pasar la capitanía)
        resource.data.captainId == request.auth.uid
        // Vice: puede editar, pero no cambiar capitán ni vice
        || (resource.data.get('viceCaptainId', null) == request.auth.uid &&
            request.resource.data.captainId == resource.data.captainId &&
            request.resource.data.get('viceCaptainId', null) == resource.data.get('viceCaptainId', null))
        // Cualquiera: ajustar el contador al unirse (+1) o irse (-1)
        || (onlyChanges(['membersCount']) && (
              (request.resource.data.membersCount == resource.data.get('membersCount', 0) + 1 &&
               isMember(clubId, request.auth.uid)) ||
              (request.resource.data.membersCount == resource.data.get('membersCount', 0) - 1 &&
               !isMember(clubId, request.auth.uid))
           ))
        // El vice que se va del club libera su puesto
        || (onlyChanges(['viceCaptainId']) &&
            resource.data.get('viceCaptainId', null) == request.auth.uid &&
            request.resource.data.viceCaptainId == null)
      );

      match /members/{memberId} {
        allow read: if true;
        allow create: if isSignedIn() && (
          // Unirse uno mismo (por código) como miembro común,
          // o el fundador como capitán
          (isOwner(memberId) &&
            (request.resource.data.role == 'member' ||
             clubData(clubId).captainId == request.auth.uid))
          // El capitán/vice acepta una solicitud
          || isCaptainOrVice(clubId)
        );
        // Cambiar roles (vice, capitán): solo capitán/vice
        allow update: if isCaptainOrVice(clubId);
        // Irse uno mismo, o que te saque el capitán/vice
        allow delete: if isOwner(memberId) || isCaptainOrVice(clubId);
      }
    }

    // ── Solicitudes de unión a club ───────────────────────
    match /joinRequests/{requestId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.playerId || isCaptainOrVice(resource.data.clubId));
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.playerId &&
        request.resource.data.status == 'PENDING';
      allow update: if isSignedIn() && request.resource.data.clubId == resource.data.clubId && (
        // El capitán/vice acepta o rechaza
        isCaptainOrVice(resource.data.clubId)
        // El jugador solo puede guardar el id del documento
        || (request.auth.uid == resource.data.playerId && onlyChanges(['id']))
      );
      allow delete: if false;
    }

    // ── Torneos y partidos publicados ─────────────────────
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.organizerId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.organizerId == request.auth.uid &&
        request.resource.data.organizerId == resource.data.organizerId;
      allow delete: if isSignedIn() && resource.data.organizerId == request.auth.uid;
    }

    // ── Inscripciones a torneos ───────────────────────────
    match /registrations/{registrationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Publicaciones urgentes ────────────────────────────
    match /urgentPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorId;
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.authorId;
    }

    // ── Reportes ──────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    // ── Canchas cargadas por la comunidad ─────────────────
    match /fields/{fieldId} {
      allow read: if resource.data.status == 'approved'
        || (isSignedIn() && request.auth.uid == resource.data.addedBy)
        || isAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.addedBy
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.addedBy || isAdmin());
    }
  }
}
